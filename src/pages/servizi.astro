---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntestazioneSezione from '../components/IntestazioneSezione.astro';
import IconaServizio from '../components/IconaServizio.astro';
import { t } from '../i18n';
import { servizi } from '../lib/servizi';
---

<BaseLayout
  titolo={t('servizi.metaTitolo')}
  descrizione={t('servizi.metaDescrizione')}
  briciole={[{ etichetta: t('nav.servizi') }]}
>
  <section class="sezione">
    <div class="contenitore">
      <IntestazioneSezione
        indice="01"
        etichetta={t('nav.servizi')}
        titolo={t('servizi.titolo')}
        testo={t('servizi.introduzione')}
        id="titolo-servizi"
        principale
      />

      {/* Un quadrato per servizio. Ogni riquadro è un <details>: cliccandolo
          si apre il servizio disteso, sotto. Nessun JavaScript: apertura e
          chiusura le fa il browser. L'attributo `name` li rende un gruppo,
          quindi ne resta aperto uno per volta. E arrivando da un indirizzo
          con l'ancora — `/servizi#progettazione`, i collegamenti delle
          schede in home — il browser apre da sé il riquadro giusto. */}
      <div class="griglia-servizi">
        {
          servizi.map((servizio, indice) => (
            <details class="quadro rivela" id={servizio.id} name="servizio">
              <summary class="quadro__fronte">
                <span class="esagono quadro__icona" aria-hidden="true">
                  <IconaServizio nome={servizio.icona} />
                </span>
                <span class="quadro__numero" aria-hidden="true">
                  {String(indice + 1).padStart(2, '0')}
                </span>
                <span class="quadro__titolo">{servizio.titolo}</span>
                <span class="quadro__sommario">{servizio.sommario}</span>
                <span class="quadro__apri" aria-hidden="true">
                  {t('servizi.apri')}
                </span>
              </summary>

              <div class="quadro__corpo">
                <h2 class="solo-screen-reader">{servizio.titolo}</h2>
                {servizio.descrizione.map((paragrafo) => (
                  <p class="quadro__paragrafo">{paragrafo}</p>
                ))}
                <p class="etichetta-tecnica quadro__sottotitolo">{t('servizi.cosaComprende')}</p>
                <ul class="quadro__punti">
                  {servizio.punti.map((punto) => (
                    <li>{punto}</li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sezione trama" aria-labelledby="titolo-cta-servizi">
    <div class="contenitore contenitore--stretto">
      <h2 id="titolo-cta-servizi">{t('servizi.ctaTitolo')}</h2>
      <p class="cta__testo">{t('servizi.ctaTesto')}</p>
      <div class="gruppo-bottoni">
        <a class="bottone bottone--secondario" href="/contatti">{t('azioni.vaiAiContatti')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* La griglia dei quadrati. Sono quadrati davvero (aspect-ratio 1) finché
     sono chiusi; aprendosi, il riquadro prende tutta la riga e il contenuto
     si distende sotto. */
  .griglia-servizi {
    display: grid;
    gap: var(--space-4);
  }

  .quadro {
    border: 1px solid var(--colore-bordo);
    border-radius: var(--raggio-grande);
    background-color: var(--colore-superficie);
    background-image: var(--lucido);
    overflow: hidden;
    scroll-margin-top: calc(var(--altezza-intestazione) + var(--space-5));
    transition: border-color var(--transizione);
  }

  .quadro:hover,
  .quadro[open] {
    border-color: var(--colore-bordo-forte);
  }

  .quadro__fronte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  /* Il sommario si allunga e spinge «Apri» in fondo al riquadro: così i
     quattro quadrati hanno il comando sulla stessa riga anche quando i testi
     sono di lunghezze diverse. */
  .quadro__sommario {
    flex: 1;
  }

  .quadro__fronte::-webkit-details-marker {
    display: none;
  }

  .quadro__icona {
    width: 3rem;
    color: var(--colore-su-accento);
  }

  .quadro__icona svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .quadro__numero {
    color: var(--colore-accento);
    font-family: var(--font-mono);
    font-size: var(--testo-xs);
    letter-spacing: var(--tracciatura-etichetta);
  }

  .quadro__titolo {
    color: var(--colore-titolo);
    font-family: var(--font-display);
    font-size: var(--testo-lg);
    font-weight: 500;
    line-height: var(--interlinea-stretta);
    letter-spacing: -0.015em;
  }

  .quadro__sommario {
    color: var(--colore-testo-tenue);
    font-size: var(--testo-sm);
  }

  /* «Apri» diventa «Chiudi» quando il riquadro è aperto: due parole in
     un attributo, nessun JavaScript. */
  .quadro__apri {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    color: var(--colore-accento);
    font-family: var(--font-mono);
    font-size: var(--testo-xs);
    letter-spacing: var(--tracciatura-etichetta);
    text-transform: uppercase;
  }

  .quadro__apri::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentcolor;
    border-bottom: 2px solid currentcolor;
    transform: rotate(45deg) translate(-1px, -1px);
    transition: transform var(--transizione);
  }

  .quadro[open] .quadro__apri::after {
    transform: rotate(-135deg) translate(-1px, -1px);
  }

  .quadro__corpo {
    padding: 0 var(--space-5) var(--space-5);
    border-top: 1px solid var(--colore-bordo);
    padding-top: var(--space-5);
  }

  .quadro__paragrafo + .quadro__paragrafo {
    margin-top: var(--space-4);
  }

  .quadro__sottotitolo {
    margin-top: var(--space-5);
    margin-bottom: var(--space-3);
  }

  .quadro__punti {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: var(--misura);
  }

  .quadro__punti li {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--testo-sm);
    color: var(--colore-testo-tenue);
  }

  .quadro__punti li::before {
    content: '';
    width: 0.5rem;
    height: calc(0.5rem / var(--esagono-proporzione));
    background-color: var(--marchio-blu);
    clip-path: var(--esagono);
    transform: translateY(0.15em);
  }

  .cta__testo {
    margin-top: var(--space-4);
    max-width: var(--misura);
    color: var(--colore-testo-tenue);
    font-size: var(--testo-md);
  }

  @media (min-width: 48em) {
    .griglia-servizi {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }

    /* Chiuso è un quadrato; aperto prende tutta la riga, perché il testo di
       un servizio in mezza colonna sarebbe una colonna di francobolli. */
    .quadro:not([open]) .quadro__fronte {
      aspect-ratio: 1;
    }

    .quadro[open] {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64em) {
    .griglia-servizi {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .quadro[open] .quadro__corpo {
      columns: 2;
      column-gap: var(--space-7);
    }

    .quadro[open] .quadro__punti {
      break-inside: avoid;
    }
  }
</style>
