---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IntestazioneSezione from '../../components/IntestazioneSezione.astro';
import SchedaProgetto from '../../components/SchedaProgetto.astro';
import VisualizzatoreDisegni from '../../components/VisualizzatoreDisegni.astro';
import { t } from '../../i18n';
import { azienda } from '../../lib/azienda';
import { trovaCommittente } from '../../lib/committenti';
import { schemaProgetto } from '../../lib/schema';
import { componiDescrizione, validaTitolo } from '../../lib/seo';

export const getStaticPaths: GetStaticPaths = async () => {
  const progetti = await getCollection('progetti');
  return progetti.map((progetto) => ({
    params: { slug: progetto.id },
    props: { progetto },
  }));
};

interface Props {
  progetto: CollectionEntry<'progetti'>;
}

const { progetto } = Astro.props;
const {
  titolo,
  committente,
  categoria,
  data,
  descrizioneBreve,
  puntiChiave,
  immagine,
  immagineAlt,
  disegni,
} = progetto.data;

const { Content } = await render(progetto);

const site = Astro.site ?? new URL('http://localhost:4321');
const percorso = `/progetti/${progetto.id}`;
const commessa = trovaCommittente(committente);

const dataLeggibile = data
  ? new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }).format(data)
  : undefined;

const titoloSeo = validaTitolo(titolo, percorso);
/**
 * La coda della descrizione si compone con quello che c'è: di un lavoro può
 * mancare tutto tranne titolo e abstract, e una frase con dei buchi dentro è
 * peggio di una frase più corta.
 */
const coda = [
  categoria ? `Lavoro di ${categoria.toLowerCase()}` : 'Lavoro',
  `realizzato da ${azienda.nome}`,
  commessa ? `per ${commessa.nome}` : null,
]
  .filter(Boolean)
  .join(' ');
const descrizioneSeo = componiDescrizione(descrizioneBreve, `${coda}.`, percorso);

/**
 * Lavori simili: quelli che portano lo stesso tag, i più recenti per primi.
 * Se non bastano a fare tre schede si completa con gli altri lavori, perché
 * una riga con una scheda sola sembra un errore.
 */
const tutti = (await getCollection('progetti')).filter((p) => p.id !== progetto.id);
const perData = (a: CollectionEntry<'progetti'>, b: CollectionEntry<'progetti'>) =>
  (b.data.data?.getTime() ?? 0) - (a.data.data?.getTime() ?? 0);

const conStessoTag = categoria
  ? tutti.filter((p) => p.data.categoria === categoria).sort(perData)
  : [];
const simili = [
  ...conStessoTag,
  ...tutti.filter((p) => !conStessoTag.includes(p)).sort(perData),
].slice(0, 3);
---

<BaseLayout
  titolo={titoloSeo}
  descrizione={descrizioneSeo}
  immagine={immagine}
  tipo="article"
  pubblicatoIl={data?.toISOString()}
  briciole={[{ etichetta: t('nav.progetti'), href: '/progetti' }, { etichetta: titolo }]}
  jsonLd={[
    schemaProgetto(
      { titolo, descrizioneBreve, committente: commessa?.nome, categoria, data, immagine, percorso },
      site
    ),
  ]}
>
  <article class="sezione progetto">
    <div class="contenitore">
      {/* La pagina si apre sul titolo, non su un'immagine: quello che dice
          di che lavoro si tratta è il testo. La copertina, se c'è, arriva
          dopo i punti chiave e prima del tag. */}
      <header class="progetto__testata rivela">
        <h1>{titolo}</h1>
        <p class="progetto__sommario">{descrizioneBreve}</p>
        {
          puntiChiave && puntiChiave.length > 0 && (
            <ul class="progetto__punti">
              {puntiChiave.map((punto) => (
                <li>{punto}</li>
              ))}
            </ul>
          )
        }
        {
          disegni && disegni.length > 0 && (
            <p class="progetto__vai-disegni">
              <a class="collegamento-tecnico" href="#titolo-disegni">
                {t('progetti.vaiAiDisegni')} ↓
              </a>
            </p>
          )
        }
      </header>

      {
        immagine && (
          <img
            class="progetto__immagine"
            src={immagine}
            alt={immagineAlt ?? ''}
            width="800"
            height="500"
            decoding="async"
          />
        )
      }

      <div class="progetto__contenuto">
        {
          (commessa || categoria || dataLeggibile) && (
            <dl class="progetto__dati">
              {commessa && (
                <div>
                  <dt>{t('comune.cliente')}</dt>
                  <dd>{commessa.nome}</dd>
                </div>
              )}
              {categoria && (
                <div>
                  <dt>{t('comune.categoria')}</dt>
                  <dd>
                    <span class="etichetta etichetta--accento">{categoria}</span>
                  </dd>
                </div>
              )}
              {data && dataLeggibile && (
                <div>
                  <dt>{t('comune.data')}</dt>
                  <dd>
                    <time datetime={data.toISOString().slice(0, 10)}>{dataLeggibile}</time>
                  </dd>
                </div>
              )}
            </dl>
          )
        }

        <div class="prosa">
          <Content />
        </div>
      </div>

      <div class="gruppo-bottoni">
        <a class="bottone bottone--secondario" href="/progetti">{t('azioni.tornaAiProgetti')}</a>
        <a class="bottone bottone--primario" href="/contatti">{t('azioni.vaiAiContatti')}</a>
      </div>
    </div>
  </article>

  {disegni && disegni.length > 0 && <VisualizzatoreDisegni disegni={disegni} indice="02" />}

  {
    simili.length > 0 && (
      <section class="sezione" aria-labelledby="titolo-lavori-simili">
        <div class="contenitore">
          <IntestazioneSezione
            indice={disegni && disegni.length > 0 ? '03' : '02'}
            etichetta={categoria ?? t('nav.progetti')}
            titolo={t('progetti.lavoriSimili')}
            testo={categoria ? t('progetti.lavoriSimiliSottotitolo') : undefined}
            id="titolo-lavori-simili"
          />
          <ul class="griglia griglia--2 griglia--3 elenco-altri">
            {simili.map((altro) => (
              <li>
                <SchedaProgetto progetto={altro} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .progetto__testata {
    max-width: var(--misura);
    margin-bottom: var(--space-6);
  }

  .progetto__testata h1 {
    margin-top: var(--space-3);
  }

  /* I punti chiave: quello che si deve capire senza leggere tutto.
     Esagono davanti, come gli elenchi tecnici del resto del sito. */
  .progetto__punti {
    display: grid;
    gap: var(--space-3);
    max-width: var(--misura);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .progetto__punti li {
    display: grid;
    grid-template-columns: 0.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
    font-size: var(--testo-sm);
    color: var(--colore-testo);
  }

  .progetto__punti li::before {
    content: '';
    width: 0.5rem;
    height: calc(0.5rem / var(--esagono-proporzione));
    background-color: var(--marchio-blu);
    clip-path: var(--esagono);
    transform: translateY(0.15em);
  }

  .progetto__sommario {
    margin-top: var(--space-4);
    color: var(--colore-testo-tenue);
    font-size: var(--testo-md);
  }

  .progetto__vai-disegni {
    margin-top: var(--space-5);
  }

  .progetto__immagine {
    width: 100%;
    height: auto;
    border: 1px solid var(--colore-bordo);
    border-radius: var(--raggio);
  }

  .progetto__contenuto {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .progetto__dati {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    margin: 0;
    padding: var(--space-5);
    background-color: var(--colore-superficie);
    border: 1px solid var(--colore-bordo);
    border-radius: var(--raggio);
    font-size: var(--testo-sm);
  }

  .progetto__dati dt {
    color: var(--colore-testo-tenue);
    font-size: var(--testo-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .progetto__dati dd {
    margin: var(--space-1) 0 0;
    font-weight: 600;
    color: var(--colore-titolo);
  }

  .elenco-altri {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .elenco-altri > li {
    display: flex;
  }

  .elenco-altri > li > :global(*) {
    width: 100%;
  }

  @media (min-width: 64em) {
    .progetto__contenuto {
      grid-template-columns: 18rem 1fr;
      gap: var(--space-7);
      align-items: start;
    }

    .progetto__dati {
      position: sticky;
      top: var(--space-5);
    }
  }
</style>
