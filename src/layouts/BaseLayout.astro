---
/**
 * Struttura comune a tutte le pagine: <head> via SEO, skip link,
 * header, contenuto principale, footer.
 */
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Briciole from '../components/Briciole.astro';
import type { Voce } from '../components/Briciole.astro';
import { schemaBriciole } from '../lib/schema';
import { t, defaultLocale } from '../i18n';
import { tema } from '../lib/tema';
import '../styles/global.css';

export interface Props {
  titolo: string;
  descrizione: string;
  immagine?: string;
  tipo?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  pubblicatoIl?: string;
  /** Voci intermedie del percorso; la Home viene aggiunta in automatico. */
  briciole?: Voce[];
  /**
   * true nelle pagine che si aprono con il hero. L'intestazione è fissa e
   * trasparente: dove c'è il hero gli passa sopra, dove non c'è va lasciato
   * lo spazio, altrimenti il primo titolo finisce sotto il menu.
   */
  eroe?: boolean;
}

const {
  titolo,
  descrizione,
  immagine,
  tipo,
  noindex,
  jsonLd = [],
  pubblicatoIl,
  briciole,
  eroe = false,
} = Astro.props;

const site = Astro.site ?? new URL('http://localhost:4321');

const schemi = briciole?.length ? [...jsonLd, schemaBriciole(briciole, site)] : jsonLd;
---

<!doctype html>
<html lang={defaultLocale} data-tema={tema}>
  <head>
    <SEO
      titolo={titolo}
      descrizione={descrizione}
      immagine={immagine}
      tipo={tipo}
      noindex={noindex}
      jsonLd={schemi}
      pubblicatoIl={pubblicatoIl}
    />
    {
      /* Il foglio di stile del tema alternativo si carica solo quando serve:
         sta in `public/temi/`, fuori dal pacchetto, così il tema di serie
         non paga un byte per un vestito che non indossa. Tutte le sue
         regole sono più specifiche di quelle di base, quindi vincono
         qualunque sia l'ordine con cui i due fogli arrivano. */
      tema === '2' && <link rel="stylesheet" href="/temi/tema-2.css" />
    }
  </head>
  <body class:list={{ 'ha-eroe': eroe }}>
    <a class="salta-al-contenuto" href="#contenuto">{t('azioni.skipLink')}</a>
    <Header />
    {briciole?.length ? <Briciole voci={briciole} /> : null}
    <main id="contenuto">
      <slot />
    </main>
    <Footer />
    {import.meta.env.DEV && <script is:inline type="module">
      import { createHotContext } from '/@vite/client';
      const updates = createHotContext('/__projectune_public_refresh');
      updates.on('projectune:site-updated', () => window.location.reload());
    </script>}
  </body>
</html>
